VITE_APP_NAME="Job Portal"
VITE_API_URL="http://127.0.0.1:5000/api"

# Node API (PostgreSQL is required unless DEV_FALLBACK=true is explicitly set)
PORT="5000"
NODE_ENV="development"
DATABASE_URL="postgresql://postgres:password@localhost:5432/careergrid"
# Or use DB_HOST, DB_PORT, DB_NAME, DB_USER, and DB_PASSWORD instead.
DB_SSL="false"
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_EXPIRES_IN="1h"
CORS_ORIGIN="http://127.0.0.1:5173,http://localhost:5173"
DEV_FALLBACK="false"
ADMIN_EMAIL="admin@careergrid.dev"
ADMIN_PASSWORD_HASH="replace-with-bcrypt-hash"
AI_PROVIDER="openai-compatible"
AI_API_KEY="replace-with-provider-key"
AI_MODEL="career-assistant-model"
AI_ENABLE_RESUME_ANALYSIS="false"
